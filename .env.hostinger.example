# Copy names only. Keep real values in GitHub Actions / Hostinger secrets.
# Use a long URL-safe password (hex/base64url without ':' '/' '@') because it is
# embedded into DATABASE_URL by docker-compose.hostinger.yml.
HORIZON_POSTGRES_PASSWORD=replace-with-long-url-safe-secret

# Production validation requires at least 32 characters.
HORIZON_API_KEY=replace-with-at-least-32-random-characters

# Keep this secret even though the dedicated HORIZON API does not expose legacy
# connector routes; production runtime validation requires an encryption key.
HORIZON_TOKEN_ENCRYPTION_KEY=replace-with-secret-encryption-key

# Optional provider credentials. Empty means that provider-specific capability
# remains unavailable; it must never be replaced by fabricated evidence.
METEOFRANCE_APPLICATION_ID=
WINDY_POINT_FORECAST_API_KEY=

# Safe default: bind only to the VPS loopback interface and put a reverse proxy
# in front. Set 0.0.0.0 only for a deliberate restricted direct-IP test.
HORIZON_BIND_ADDRESS=127.0.0.1
HORIZON_PORT=8000

# Permanent world-intelligence collector. These values control polling cadence;
# they are never evidence weights and never probabilities.
HORIZON_COLLECTOR_ENABLED=true
HORIZON_COLLECTOR_TICK_SECONDS=30
HORIZON_COLLECTOR_LEASE_SECONDS=900
HORIZON_COLLECTOR_MAX_SOURCES_PER_CYCLE=10
HORIZON_COLLECTOR_SNCF_SECONDS=300
HORIZON_COLLECTOR_VIGICRUES_SECONDS=600
HORIZON_COLLECTOR_METEOFRANCE_SECONDS=600
HORIZON_COLLECTOR_METEOALARM_SECONDS=600
HORIZON_COLLECTOR_GDELT_SECONDS=900
HORIZON_COLLECTOR_GDACS_SECONDS=900
HORIZON_COLLECTOR_FUEL_SECONDS=900
HORIZON_COLLECTOR_RTE_SECONDS=900
HORIZON_COLLECTOR_WINDY_SECONDS=1800
HORIZON_COLLECTOR_SYNTHESIS_SECONDS=900
HORIZON_COLLECTOR_MAX_ACTIVE_EVENTS=200
HORIZON_COLLECTOR_EVENT_GRAPH_LOOKBACK_HOURS=336

# false = the existing core European MeteoAlarm country set; true = every
# country currently supported by the adapter.
HORIZON_COLLECTOR_METEOALARM_ALL_EUROPE=false

# Optional comma-separated RTE region codes. Empty keeps the RTE adapter default.
HORIZON_COLLECTOR_RTE_REGION_CODES=

# Optional Windy Point Forecast points. Keep this JSON on one line.
# Example:
# [{"lat":48.8566,"lon":2.3522,"geography":["FR","75"],"heat_watch_threshold_c":32}]
HORIZON_COLLECTOR_WINDY_POINTS_JSON=[]

# Historical calibration corpus worker. It is intentionally rate-separated from
# live collection so historical backfills cannot starve current-world polling.
HORIZON_CORPUS_WORKER_ENABLED=true
HORIZON_CORPUS_WORKER_INTERVAL_SECONDS=21600
HORIZON_CORPUS_WORKER_LEASE_SECONDS=7200
HORIZON_CORPUS_WORKER_MAX_RUNS_PER_CYCLE=1
HORIZON_CORPUS_WORKER_SLICES_PER_RUN=1
