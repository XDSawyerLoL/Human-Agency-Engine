# Hostinger VPS production environment.
# Copy to .env.hostinger (or enter these values in Hostinger Docker Manager).
# Never commit real secret values.

# Persistent PostgreSQL. Use a long URL-safe password because docker-compose
# embeds it into DATABASE_URL.
HORIZON_POSTGRES_PASSWORD=replace-with-long-url-safe-secret

# Production validation requires at least 32 characters.
HORIZON_API_KEY=replace-with-at-least-32-random-characters
HORIZON_TOKEN_ENCRYPTION_KEY=replace-with-secret-encryption-key

# Optional provider credentials. Empty means that capability is skipped; the
# engine must never invent evidence when a provider is unavailable.
METEOFRANCE_APPLICATION_ID=
WINDY_POINT_FORECAST_API_KEY=
FRED_API_KEY=
METACULUS_API_KEY=
COPERNICUS_API_KEY=
FORECAST_API_KEY=
POINT_API_KEY=

# HORIZON API is intentionally private by default. Put a reverse proxy in front
# only if the API itself must be exposed outside the VPS.
HORIZON_BIND_ADDRESS=127.0.0.1
HORIZON_PORT=8000

# ÉVIDENCE public cockpit. Port 8080 is safe to expose directly for an initial
# test; attach the production domain/TLS with Hostinger's proxy tooling later.
EVIDENCE_BIND_ADDRESS=0.0.0.0
EVIDENCE_HTTP_PORT=8080
EVIDENCE_SNAPSHOT_INTERVAL_SECONDS=300
EVIDENCE_FORECAST_LIMIT=20

# AURA / Mairaiy voice sidecar.
# This is the historical AURA voice: Kokoro ONNX + ff_siwis, exposed through
# the same VoiceStudio-compatible speech contract used by AURA Voice Fabric.
MAIRAIY_VOICE_ENABLED=false
OMNIVOICE_API_KEY=replace-with-at-least-24-random-characters
MAIRAIY_KOKORO_VOICE=ff_siwis
MAIRAIY_KOKORO_LANGUAGE=fr-fr
MAIRAIY_KOKORO_SPEED=1.0
MAIRAIY_KOKORO_CHUNK_CHARS=430

# Permanent world-intelligence collector. Cadence values control polling only;
# they are not evidence weights or probabilities.
HORIZON_COLLECTOR_ENABLED=true
HORIZON_COLLECTOR_TICK_SECONDS=30
HORIZON_COLLECTOR_LEASE_SECONDS=900
HORIZON_COLLECTOR_MAX_SOURCES_PER_CYCLE=10
HORIZON_COLLECTOR_SNCF_SECONDS=300
HORIZON_COLLECTOR_VIGICRUES_SECONDS=600
HORIZON_COLLECTOR_METEOFRANCE_SECONDS=600
HORIZON_COLLECTOR_METEOALARM_SECONDS=600
HORIZON_COLLECTOR_GDELT_SECONDS=900
HORIZON_COLLECTOR_GDACS_SECONDS=900
HORIZON_COLLECTOR_FUEL_SECONDS=900
HORIZON_COLLECTOR_RTE_SECONDS=900
HORIZON_COLLECTOR_WINDY_SECONDS=1800
HORIZON_COLLECTOR_WORLD_PULSE_SECONDS=900
HORIZON_COLLECTOR_SYNTHESIS_SECONDS=900
HORIZON_COLLECTOR_MAX_ACTIVE_EVENTS=300
HORIZON_COLLECTOR_EVENT_GRAPH_LOOKBACK_HOURS=336
HORIZON_COLLECTOR_METEOALARM_ALL_EUROPE=true
HORIZON_COLLECTOR_RTE_REGION_CODES=

# Optional Windy Point Forecast points. Keep the JSON on one line.
# Example:
# [{"lat":48.8566,"lon":2.3522,"geography":["FR","Paris"]}]
HORIZON_COLLECTOR_WINDY_POINTS_JSON=[]

# Historical calibration corpus worker. It is rate-separated from live polling.
HORIZON_CORPUS_WORKER_ENABLED=true
HORIZON_CORPUS_WORKER_INTERVAL_SECONDS=21600
HORIZON_CORPUS_WORKER_LEASE_SECONDS=7200
HORIZON_CORPUS_WORKER_MAX_RUNS_PER_CYCLE=1
HORIZON_CORPUS_WORKER_SLICES_PER_RUN=1

# Local PostgreSQL backups on the VPS. Hostinger VPS backups remain useful, but
# these dumps give HORIZON its own application-level recovery points too.
HORIZON_BACKUP_INTERVAL_SECONDS=86400
HORIZON_BACKUP_RETENTION_DAYS=7

# AURA Software Engine / OpenHands Agent Server.
# This stack is started only with: docker compose --profile software-agent up -d
# The public HORIZON API stays separate. software-control binds to loopback only.
SOFTWARE_AGENT_SESSION_API_KEY=replace-with-long-random-session-key
OPENHANDS_SECRET_KEY=replace-with-a-stable-long-random-secret

# OpenHands images are pinned to the SDK main revision audited on 2026-09-28.
# Override deliberately when upgrading; do not silently track an unreviewed image.
OPENHANDS_AGENT_SERVER_TAG=3311ba9-python-amd64
OPENHANDS_CONVERSATION_IMAGE=ghcr.io/openhands/agent-server:3311ba9-python-amd64
OPENHANDS_MAX_CONCURRENT_RUNS=2
OPENHANDS_CONVERSATION_MEMORY=4g
OPENHANDS_CONVERSATION_CPUS=2
OPENHANDS_CONVERSATION_PIDS_LIMIT=512
OPENHANDS_CONVERSATION_IDLE_TTL_SECONDS=1200

# Model used by the OpenHands Agent Profile.
# No paid provider is required. For a local Ollama server reachable from Docker:
#   SOFTWARE_AGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# OpenHands needs a large context window (32k recommended). Choose the model only
# after checking VPS RAM/GPU. The profile bootstrap performs a real 1-token
# preflight and refuses to activate a broken endpoint.
SOFTWARE_AGENT_LLM_MODEL=
SOFTWARE_AGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
SOFTWARE_AGENT_LLM_API_KEY=local-llm
SOFTWARE_AGENT_LLM_PROFILE_NAME=aura-local
SOFTWARE_AGENT_PROFILE_NAME=aura-software

SOFTWARE_AGENT_ALLOWED_REPOSITORIES=XDSawyerLoL/Human-Agency-Engine
SOFTWARE_AGENT_MAX_ITERATIONS=80
SOFTWARE_AGENT_TIMEOUT_SECONDS=20
SOFTWARE_CONTROL_BIND_ADDRESS=127.0.0.1
SOFTWARE_CONTROL_PORT=8001

# Public read-only clone used as the base workspace. The init container forces
# origin.pushurl to a disabled scheme; no GitHub write credential is mounted.
SOFTWARE_AGENT_REPOSITORY_URL=https://github.com/XDSawyerLoL/Human-Agency-Engine.git
SOFTWARE_AGENT_REPOSITORY_REF=main

# Optional outbound registration in AURA Cloud. Keep token in Hostinger/GitHub
# secrets rather than this file.
AURA_CLOUD_URL=https://antiquewhite-dolphin-780448.hostingersite.com
AURA_CLOUD_TOKEN=
