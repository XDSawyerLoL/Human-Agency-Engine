{
  "version": 2,
  "regions": ["fra1"],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "DENY"}]},
    {"source": "/admin.html", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]}
  ]
}