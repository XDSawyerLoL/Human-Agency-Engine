FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 espeak-ng ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY mairaiy_voice_service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY mairaiy_voice_service/app.py ./app.py

RUN mkdir -p /models

EXPOSE 3900

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "3900"]
