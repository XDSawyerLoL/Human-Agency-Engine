APP_ENV=development
DATABASE_URL=sqlite:///./human_agency.db
API_KEY=change-me
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/connectors/google/callback
GOOGLE_SYNC_LOOKBACK_DAYS=14
GOOGLE_SYNC_LOOKAHEAD_DAYS=60
GOOGLE_MAX_GMAIL_MESSAGES=250

# Provider credentials. Real values belong in local .env, GitHub Secrets or Hostinger secrets.
METEOFRANCE_APPLICATION_ID=
WINDY_POINT_FORECAST_API_KEY=

# Optional Windy collection points. A Windy Point Forecast testing key must not be
# used as production evidence because Windy's testing API returns modified data.
HORIZON_COLLECTOR_WINDY_POINTS_JSON=[]

# Optional AURA Software Engine. Disabled until an isolated OpenHands Agent Server
# and a server-side Agent Profile are configured.
SOFTWARE_AGENT_ENABLED=false
SOFTWARE_AGENT_BASE_URL=http://127.0.0.1:3000
SOFTWARE_AGENT_SESSION_API_KEY=
SOFTWARE_AGENT_AGENT_PROFILE_ID=
SOFTWARE_AGENT_WORKSPACE_ROOT=/workspace/repos
SOFTWARE_AGENT_ALLOWED_REPOSITORIES=XDSawyerLoL/Human-Agency-Engine
SOFTWARE_AGENT_MAX_ITERATIONS=80
SOFTWARE_AGENT_TIMEOUT_SECONDS=20
SOFTWARE_AGENT_REQUIRE_ATTESTATION=true
