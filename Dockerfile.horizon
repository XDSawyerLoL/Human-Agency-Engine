FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

RUN groupadd --system providence \
    && useradd --system --gid providence --home-dir /home/providence --create-home --shell /usr/sbin/nologin providence

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
COPY app ./app
COPY scripts ./scripts

RUN chown -R providence:providence /app /home/providence
USER providence

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.horizon_api:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]
