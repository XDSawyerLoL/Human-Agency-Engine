# ÉVIDENCE / HORIZON — Hostinger managed Node.js
# Add these values in hPanel -> Web App -> Environment variables.
# Never commit real secret values.

EVIDENCE_REFRESH_SECONDS=600
EVIDENCE_FORECAST_LIMIT=72

# Optional protected admin actions: manual resolution and forced refresh.
EVIDENCE_ADMIN_KEY=replace-with-a-long-random-secret

# Provider keys already used by the World Eye.
FRED_API_KEY=
FORECAST_API_KEY=
WINDY_KEY=
COPERNICUS_API_KEY=
POINT_API_KEY=
METACULUS_API_KEY=

# Persistent learning / Track Record.
# EITHER one MySQL connection URL:
MYSQL_URL=mysql://user:password@host:3306/database

# OR the five separate values below (they override MYSQL_URL when present):
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# DATABASE_URL is also accepted when it uses mysql:// or mariadb://.

# Quantic Network relay is embedded in this Node runtime when MySQL is configured.
# Optional: override the public origin or use a dedicated secret.
QUANTIC_PUBLIC_ORIGIN=https://mediumorchid-badger-314305.hostingersite.com
QUANTIC_RELAY_IDENTITY_SECRET=
# Optional external relay URL override. Leave empty for the embedded same-site relay.
QUANTIC_HOSTINGER_RELAY_URL=


# Mairaiy — native Node voice on the same Hostinger Web App.
# Defaults are intentionally usable without another server or API key.
MAIRAIY_NODE_NATIVE_ENABLED=true
MAIRAIY_PUBLIC_SPEECH_ENABLED=true
MAIRAIY_PUBLIC_REQUESTS_PER_MINUTE=6
MAIRAIY_PUBLIC_REQUESTS_PER_DAY=240
MAIRAIY_KOKORO_DTYPE=q8
# Optional cache location. /tmp is suitable for the managed Node runtime.
MAIRAIY_KOKORO_CACHE_DIR=/tmp/quantic-mairaiy-kokoro

# Optional legacy upstream fallback. Leave empty in the normal managed-Node setup.
MAIRAIY_VOICE_UPSTREAM_URL=
MAIRAIY_VOICE_PROXY_TOKEN=
MAIRAIY_VOICE_UPSTREAM_API_KEY=
MAIRAIY_VOICE_PROXY_TIMEOUT_MS=120000
