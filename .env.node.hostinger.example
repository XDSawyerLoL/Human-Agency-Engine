# ÉVIDENCE / HORIZON — Hostinger managed Node.js
# Add these values in hPanel -> Web App -> Environment variables.
# Never commit real secret values.

EVIDENCE_REFRESH_SECONDS=600
EVIDENCE_FORECAST_LIMIT=72

# Optional protected admin actions: manual resolution and forced refresh.
EVIDENCE_ADMIN_KEY=replace-with-a-long-random-secret

# Provider keys already used by the World Eye.
FRED_API_KEY=
FORECAST_API_KEY=
WINDY_KEY=
COPERNICUS_API_KEY=
POINT_API_KEY=
METACULUS_API_KEY=

# Persistent learning / Track Record.
# EITHER one MySQL connection URL:
MYSQL_URL=mysql://user:password@host:3306/database

# OR the five separate values below (they override MYSQL_URL when present):
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# DATABASE_URL is also accepted when it uses mysql:// or mariadb://.
